        <mxCell id="enc-identity" value="zero-init gate + zero-init additive conditioning&#10;⇒ all-valid input ≡ M0&#10;(identity test · m=0 protection)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;fontStyle=2;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="262" y="535" width="306" height="80" as="geometry"/></mxCell>
